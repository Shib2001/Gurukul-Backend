APP_ENV=production
APP_NAME=gurukul-be
API_V1_PREFIX=/api/v1
POSTGRES_DB=gurukul
POSTGRES_USER=gurukul
# Set a strong URL-safe password before starting Docker Compose.
POSTGRES_PASSWORD=
DOMAIN=api.example.com
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://gurukul:dev-only-password@localhost:5433/gurukul
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGINS=http://localhost:3000
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_AUTH_KEY=replace-me
# Generate a random secret of at least 32 characters before using auth endpoints.
SESSION_SECRET=
# Password-reset email delivery (SSL and STARTTLS are mutually exclusive).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
# Local testing only; ignored unless APP_ENV=development.
PASSWORD_RESET_RETURN_CODE_IN_RESPONSE=false
# Local testing only; ignored unless APP_ENV=development.
EMAIL_VERIFICATION_RETURN_CODE_IN_RESPONSE=false
OBJECT_STORAGE_BUCKET=gurukul-local
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=replace-me
OBJECT_STORAGE_SECRET_KEY=replace-me
OTEL_EXPORTER_OTLP_ENDPOINT=




# Live db url 

LIVE_BACKEND_URL = http://54.79.154.40:8000/